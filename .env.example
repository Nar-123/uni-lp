# =============================================================================
# Copy to .env and fill in. Never commit .env
#   cp .env.example .env
# =============================================================================

# --- Telegram (required) ---
# From @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id(s), comma-separated
# Get id from @userinfobot or similar
TELEGRAM_USER_IDS=

# --- Hot wallet(s) (optional) ---
# Multi-wallet store: data/wallets.json (generate / import via /wallet in Telegram)
# If unset, migrates PRIVATE_KEY or legacy data/hot-wallet.json, else auto-generates
# PRIVATE_KEY=0x...

# Optional path for multi-wallet store (default ./data/wallets.json)
# WALLETS_PATH=./data/wallets.json

# Legacy single-wallet path (migrated once into wallets.json)
# WALLET_PATH=./data/hot-wallet.json

# --- RPC (required for chain ops) ---
# Robinhood Chain (4663) — public RPC often rate-limited; Alchemy/QuickNode recommended
# Example Alchemy: https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_4663=https://rpc.mainnet.chain.robinhood.com

# BNB Smart Chain (56)
RPC_56=https://1rpc.io/bnb

# Base (8453) — public mainnet.base.org is fine for light use; Alchemy/QuickNode for production
RPC_8453=https://mainnet.base.org

# Optional: USDC on Robinhood if you use it
# USDC_4663=0x...

# Optional ledger path (default ./data/bot.json)
# DB_PATH=./data/bot.json

# Optional Relay API key (higher rate limits for /bridge)
# https://docs.relay.link/references/api/api-keys
# RELAY_API_KEY=

# Across Swap API — raced with Relay for best bridge/swap quote
# https://docs.across.to/tools/integrator-id
# ACROSS_API_KEY=acx_...
# ACROSS_INTEGRATOR_ID=0x...

# Uniswap Trading API — multi-hop v2/v3/v4 for /swap custom CA (mint helpers)
# https://developers.uniswap.org/
# NOT used for close zapout or /tokens meme sell (those hard-require GMGN)
# UNISWAP_API_KEY=

# --- GMGN (required for zapout + /screener + /tokens sell) ---
# Install: https://github.com / gmgn-cli binary on PATH
# Credentials live in ~/.config/gmgn/ (gmgn-cli config) — this process never reads the key
# GMGN_CLI_PATH=gmgn-cli
# GMGN_SLIPPAGE_PCT=15
# GMGN_SWAP_MODE=local
#   local (default): gmgn-cli order quote → bot hot wallet signs
#   managed: gmgn-cli swap signs from the wallet bound to your GMGN API key
#            (imports hot key into GMGN — see SECURITY.md)
# GMGN_WALLET_ADDRESS=0x...          # only if managed
# GMGN_ALLOW_AUTOMATED_TRADES=1      # only if managed
